# ==========================================
# 1. VARIAVEIS DA API ISHIKAWA
# ==========================================
# A API Ishikawa (FastAPI) acessa o Router (FastAPI) localmente na porta 8001
ROUTER_BASE_URL=http://localhost:8001
ROUTER_SECRET_KEY="Api-key"
ML_API_KEY="Api-key"
ML_API_URL = https://api-educampoml-custoleite-4j44.onrender.com
API_KEY="Api-key"
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Auditoria de Logs ---
AUDIT_LOGS_ENABLED=True
AUDIT_LOGS_DIR=logs

# --- Consultor Padrao (Dev / Mock) ---
DEFAULT_CONSULTANT_ID=consultant-default-uuid
DEFAULT_CONSULTANT_NAME="Consultor Educampo"
DEFAULT_CONSULTANT_EMAIL=consultor@educampo.com
DEFAULT_CONSULTANT_PASSWORD=admin123

# --- Autenticacao JWT ---
JWT_SECRET_KEY="super_secret_jwt_key_educampo_2026"
JWT_ALGORITHM="HS256"
SESSION_COOKIE_SECURE=false

# --- Rate Limiting ---
RATE_LIMIT_GLOBAL="1000/minute"
RATE_LIMIT_DIAGNOSTICO="100/minute"
RATE_LIMIT_SIMULACAO="200/minute"
RATE_LIMIT_PARAMETROS="500/minute"
RATE_LIMIT_TEST_DATA="1000/minute"

# --- Integracao DB_API_Ishikawa (na API Ishikawa) ---
DB_API_URL=http://localhost:8002
DB_API_DOCKER_URL=http://host.docker.internal:8002
DB_API_SERVICE_TOKEN="seu_token_m2m_aqui"
DB_API_TIMEOUT=10.0
PERSISTENCE_BACKEND=http

# ==========================================
# 2. VARIAVEIS DO LLM ROUTER
# ==========================================
OPENROUTER_API_KEY="cole_sua_chave_do_openrouter_aqui"

# Modelos pagos
ISHIKAWA_MODELS=["google/gemini-3.1-flash-lite"]
SEVERIDADE_MODELS=["openai/gpt-oss-20b", "openai/gpt-5-nano", "deepseek/deepseek-v4-flash", "google/gemini-2.5-flash-lite", "qwen/qwen3.6-flash", "anthropic/claude-3-haiku", "openai/gpt-5-mini"]

GLOBAL_CONCURRENT_MARGIN="2"
MODEL_RPM_BURST_THRESHOLD="6"
SEVERIDADE_OPENROUTER_PRESET="@preset/llm-router-severidade"
ISHIKAWA_OPENROUTER_PRESET="@preset/llm-router-diagnostico"
ALLOWED_DOMAINS=["http://localhost:8000"]

APP_NAME="API_LLM_Router"
APP_URL="https://github.com/Educampo-UFV/API_LLM_Router.git"

# ==========================================
# 3. VARIAVEIS DO SITE NEXT.JS (FRONTEND)
# ==========================================
# O BFF (Next.js server) se comunica com a API Ishikawa na porta 8000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=/api

# Token de Autenticacao da API
API_TOKEN="Api-key"

ENABLE_PAYLOAD_ENCRYPTION=false
ENCRYPTION_SECRET_KEY="Api-key"

# Credenciais de Admin
ADMIN_USERNAME=admin_local
ADMIN_PASSWORD=senha_local_123

NEXT_PUBLIC_ENABLE_TEST_FARMS=true

# ==========================================
# 4. VARIAVEIS DO DB_API_ISHIKAWA
# ==========================================
ENVIRONMENT=development
API_V1_STR=/v1

# Database Configuration (Supabase PostgreSQL - Session Mode porta 5432)
DATABASE_URL=postgresql+psycopg://postgres.eassnhmqfltvnyyjemns:[SUA_SENHA_AQUI]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Inter-service Authentication (M2M)
SERVICE_TOKEN="seu_token_m2m_aqui"

# Port
PORT=8002

# Seed de dados
SEED_ON_STARTUP=false
SEED_DATA_PATH=app/resources/test_data/farms.json

# Pool de conexoes
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

